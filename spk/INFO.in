package="btrbk-nas"
version="@VERSION@-0001"
os_min_ver="7.0-40000"
arch="x86_64"
displayname="btrbk Backups"
description="See the btrbk backups this NAS receives: freshness of every subvolume, incomplete receives, and the files inside any snapshot, ready to download."
description_ita="Visualizza i backup btrbk che arrivano su questo NAS: aggiornamento di ogni subvolume, ricezioni incomplete e i file di ogni snapshot, pronti da scaricare."
maintainer="rylos"
maintainer_url="https://github.com/rylos"
dsmuidir="ui"
dsmappname="SYNO.SDS.BtrbkNas.Instance"
thirdparty="yes"
silent_install="yes"
silent_upgrade="yes"
silent_uninstall="yes"
